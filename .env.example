# PrintDesk configuration. Copy to .env and edit:  cp .env.example .env
# Loaded with `node --env-file=.env` (npm start / pm2). Never commit .env.

# ---------- server ----------
NODE_ENV=production
PORT=3100
# Listen on localhost only; nginx proxies the public domain to it.
HOST=127.0.0.1
# Public address (used in order links, QR codes and emails). No trailing slash.
BASE_URL=https://print.brightonsolution.com
# Number of proxies in front of the app (nginx = 1). Needed for real client IPs and rate limits.
TRUST_PROXY=1

# Long random secret that signs login cookies (at least 32 characters).
# Generate one with:  openssl rand -hex 32
# Changing it logs everybody out.
SESSION_SECRET=

# ---------- super admin ----------
# Admin panel host (needs a DNS A record). Leave empty to use /admin on the main site.
ADMIN_HOST=admin.print.brightonsolution.com
# Values are cut at '#' unless quoted: wrap passwords in single quotes, e.g. ADMIN_PASSWORD='my#pass'
ADMIN_EMAIL=
# Plain password, or a bcrypt hash starting with $2 (recommended). From the app folder:
#   node -e 'console.log(require("bcryptjs").hashSync(process.argv[1], 10))' 'your-password'
ADMIN_PASSWORD=''

# ---------- data ----------
# Database, uploaded files and logos. Keep it OUTSIDE the code folder so
# `git pull` never touches it, and include it in your backups.
DATA_DIR=/var/lib/printdesk
# Refuse new uploads when the disk has less than this much free space (MB).
MIN_FREE_DISK_MB=3072
# Optional storage cap per shop in GB (0 = use each plan's storage, set in Admin → Plans).
SHOP_QUOTA_GB=0
# Days a free demo shop (created from /demo) runs before it must go live.
DEMO_DAYS=7

# ---------- payments (Razorpay) ----------
# Razorpay Dashboard → Account & Settings → API Keys. Leave empty until KYC is done:
# shops then see "online payment is being set up" and you record UPI payments in Admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=''
# Razorpay Dashboard → Webhooks → URL https://print.brightonsolution.com/webhooks/razorpay,
# event "payment_link.paid", and the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=''

# ---------- region ----------
# Time zone for dates shown in the app, and the default country code for WhatsApp links.
APP_TZ=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91

# ---------- email (optional) ----------
# Leave SMTP_HOST empty to switch email off (WhatsApp buttons still work).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=''
SMTP_FROM="PrintDesk <no-reply@brightonsolution.com>"
